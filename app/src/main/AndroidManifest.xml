<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebView 加载本地 HTTP 服务、Node 打开网络/本地端口 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 前台服务保活（防止 Doze 杀掉 Node 进程） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) 要求显式声明前台服务类型；dataSync 贴切“本地运行时”语义 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NodeContainerApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NodeContainer"
        tools:targetApi="34">

        <!-- Node 运行时：独立进程 :node，与 UI 进程隔离；exported=false 防外部拉起 -->
        <service
            android:name=".NodeRuntimeService"
            android:exported="false"
            android:process=":node"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
