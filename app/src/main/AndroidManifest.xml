<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebView 加载本地 HTTP 服务、Node 打开网络/本地端口 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 前台服务保活（防止 Doze 杀掉 Node 进程） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) 要求显式声明前台服务类型；dataSync 贴切“本地运行时”语义 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知授权 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NodeContainerApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NodeContainer"
        tools:targetApi="34"
        tools:ignore="UnusedAttribute"
        android:extractNativeLibs="true">
        <!--
          android:extractNativeLibs="true" 是必须的，且与 packaging.jniLibs.
          useLegacyPackaging = true 是同一件事的两种写法（两处都写，双保险）。

          原因：我们要 exec 的 node 二进制，以 jniLibs/arm64-v8a/libnode.so 的形式
          打包。只有 extractNativeLibs=true，Android 才会在【安装时】把这个 .so
          从 APK 里解压到
              /data/app/~~xxxx/<pkg>-yyyy/lib/arm64-v8a/libnode.so
          而那个目录是 SELinux 唯一允许 exec 的应用目录（label exec_type）。

          若为 false（AGP 3.6+ 的默认），.so 会以压缩形式留在 APK 内、运行时直接
          mmap 加载，不会在文件系统上落盘 —— 我们就拿不到可执行的路径，
          ProcessBuilder 会以 error=2 (No such file) 或 error=13 失败。

          顺带说明：这个属性只影响「.so 是否解压落盘」，不改变任何权限语义，
          也不影响 minSdk/兼容性。
        -->

        <!-- Node 运行时：独立进程 :node，与 UI 进程隔离；exported=false 防外部拉起 -->
        <service
            android:name=".NodeRuntimeService"
            android:exported="false"
            android:process=":node"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
